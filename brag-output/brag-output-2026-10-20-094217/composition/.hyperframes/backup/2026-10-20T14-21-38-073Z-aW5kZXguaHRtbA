<!DOCTYPE html>
<html lang="es" data-resolution="portrait">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=1080,height=1920">
  <title>Tailor CV — Reel</title>
  <script src="assets/gsap.min.js"></script>
  <style>
    *{box-sizing:border-box}
    html,body{margin:0;width:1080px;height:1920px;overflow:hidden}
    body{font-family:Arial,Helvetica,sans-serif;background:#f7faff;color:#0f172a}
    #root{position:relative;width:100%;height:100%;overflow:hidden;background:#f7faff}
    .clip{position:absolute;inset:0;overflow:hidden}
    .scene{background:radial-gradient(circle at 88% 8%,#dbeafe 0,#f7faff 34%,#fff 78%)}
    .brand{position:absolute;left:64px;top:64px;display:flex;align-items:center;gap:14px;color:#1d4ed8;font-size:29px;font-weight:800}
    .brand-mark{width:52px;height:52px;display:grid;place-items:center;border-radius:14px;background:#2563eb;color:#fff;box-shadow:0 12px 28px #2563eb35}
    .kicker{color:#2563eb;font-size:24px;font-weight:900;letter-spacing:.12em;text-transform:uppercase}
    h1,h2,h3,p{margin:0}
    h1,h2{font-size:91px;line-height:1.01;letter-spacing:-.055em}
    h3{font-size:35px;line-height:1.12}
    .accent{color:#2563eb}
    .lead{font-size:34px;line-height:1.35;color:#475569}
    .title-zone{position:absolute;left:64px;right:64px;top:235px}
    .title-zone .kicker{margin-bottom:24px}
    .title-zone .lead{margin-top:30px}
    .surface{background:#fff;border:2px solid #dbe5f1;border-radius:30px;box-shadow:0 38px 90px #1e3a8a24}
    .vacancies{position:absolute;left:64px;right:64px;top:790px;height:900px}
    .job-card{position:absolute;left:0;width:610px;height:210px;padding:31px 34px;background:#fff;border:2px solid #dbe5f1;border-radius:24px;box-shadow:0 22px 55px #1e3a8a18}
    .job-card:nth-child(1){top:0;transform:rotate(-4deg)}
    .job-card:nth-child(2){top:205px;left:95px;transform:rotate(3deg)}
    .job-card:nth-child(3){top:420px;left:22px;transform:rotate(-2deg)}
    .job-meta{font-size:22px;color:#64748b;margin-bottom:13px}
    .job-title{font-size:34px;font-weight:800}
    .job-tags{display:flex;gap:10px;margin-top:24px}
    .tag{padding:8px 13px;border-radius:99px;background:#dbeafe;color:#1d4ed8;font-size:18px;font-weight:700}
    .resume-card{position:absolute;right:0;top:92px;width:410px;height:650px;padding:42px;background:#fff;border:2px solid #bfdbfe;border-radius:24px;box-shadow:0 30px 75px #1e3a8a24}
    .resume-head{height:74px;background:#2563eb;border-radius:13px;margin-bottom:34px}
    .line{height:13px;border-radius:10px;background:#cbd5e1;margin-bottom:20px}
    .line.short{width:60%}.line.medium{width:82%}
    .again{position:absolute;right:-8px;bottom:72px;padding:17px 23px;border-radius:14px;background:#fef3c7;color:#92400e;font-size:24px;font-weight:900;transform:rotate(4deg)}
    .pain-grid{position:absolute;left:64px;right:64px;top:750px;display:grid;grid-template-columns:1fr 1fr;gap:28px}
    .pain-card{height:520px;padding:48px 42px;position:relative;overflow:hidden}
    .pain-number{font-size:132px;font-weight:900;letter-spacing:-.07em;color:#2563eb}
    .pain-label{font-size:35px;font-weight:800;margin-top:20px}
    .pain-copy{font-size:26px;line-height:1.35;color:#64748b;margin-top:18px}
    .clock{width:260px;height:260px;border:18px solid #2563eb;border-radius:50%;margin:22px auto 40px;position:relative}
    .clock:before,.clock:after{content:'';position:absolute;left:50%;top:50%;width:10px;border-radius:9px;background:#0f172a;transform-origin:bottom center}
    .clock:before{height:78px;transform:translate(-50%,-100%) rotate(25deg)}
    .clock:after{height:102px;transform:translate(-50%,-100%) rotate(128deg)}
    .no-call{display:grid;place-items:center;width:190px;height:190px;border-radius:50%;margin:38px auto;background:#fee2e2;color:#b91c1c;font-size:84px;font-weight:900}
    .app-shell{position:absolute;left:48px;right:48px;top:660px;height:1070px;padding:30px;background:#eef4ff;border-radius:36px;border:2px solid #cfe0ff;box-shadow:0 38px 90px #1e3a8a20}
    .app-top{height:82px;display:flex;align-items:center;justify-content:space-between;padding:0 24px;font-size:27px;font-weight:900}
    .app-top small{font-size:20px;color:#64748b}
    .flow{height:900px;display:grid;grid-template-columns:1fr 88px 1fr;align-items:center;gap:16px}
    .panel{height:690px;padding:37px;background:#fff;border:2px solid #dbe5f1;border-radius:25px;box-shadow:0 20px 45px #1e3a8a16}
    .panel-title{font-size:28px;font-weight:900;margin-bottom:30px}
    .input{min-height:72px;padding:20px;border:2px solid #dbe5f1;border-radius:14px;background:#fbfdff;color:#334155;font-size:22px;line-height:1.35;margin-bottom:20px}
    .textarea{height:230px}
    .cta{display:inline-block;margin-top:14px;padding:17px 22px;border-radius:13px;background:#2563eb;color:white;font-size:23px;font-weight:900}
    .arrow{display:grid;place-items:center;width:72px;height:72px;border-radius:50%;background:#2563eb;color:#fff;font-size:38px;font-weight:900;box-shadow:0 14px 30px #2563eb40}
    .cv-mini{height:585px;padding:35px;background:#fff;border:2px solid #bfdbfe;border-radius:18px}
    .cv-mini h3{color:#1d4ed8;margin-bottom:8px}
    .cv-mini .role{font-size:21px;color:#64748b;margin-bottom:28px}
    .cv-mini h4{font-size:21px;color:#1d4ed8;margin:27px 0 15px}
    .analysis-shell{position:absolute;left:48px;right:48px;top:650px;height:1080px;padding:34px}
    .analysis-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:34px}
    .analysis-head h3{font-size:31px}
    .score{font-size:78px;font-weight:900;color:#2563eb;letter-spacing:-.05em}
    .score small{font-size:34px}
    .analysis-copy{font-size:25px;line-height:1.4;color:#475569}
    .metrics{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin:40px 0}
    .metric{padding:28px 15px;border-radius:18px;text-align:center;background:#eff6ff;color:#1d4ed8}
    .metric:nth-child(2){background:#faf5ff;color:#7e22ce}.metric:nth-child(3){background:#f0fdf4;color:#15803d}
    .metric strong{display:block;font-size:43px}.metric span{font-size:19px}
    .suggestions{display:grid;gap:18px}
    .suggestion{padding:24px 27px;border-radius:17px;background:#f8fafc;border:2px solid #e2e8f0;font-size:24px;font-weight:700}
    .suggestion b{color:#2563eb}
    .email-shell{position:absolute;left:70px;right:70px;top:650px;height:1040px;padding:42px 46px}
    .email-title{display:flex;align-items:center;justify-content:space-between;margin-bottom:34px}
    .email-title h3{font-size:37px}
    .mail-icon{width:74px;height:74px;display:grid;place-items:center;border-radius:18px;background:#dbeafe;color:#1d4ed8;font-size:38px}
    .field-label{font-size:22px;font-weight:800;margin:22px 0 10px}
    .email-field{padding:20px 22px;border:2px solid #dbe5f1;border-radius:13px;background:#fbfdff;font-size:24px;color:#334155}
    .email-body{height:320px;line-height:1.45}
    .send-row{display:flex;align-items:center;justify-content:space-between;margin-top:32px}
    .send-button{padding:19px 29px;border-radius:14px;background:#2563eb;color:#fff;font-size:25px;font-weight:900}
    .sent{padding:14px 20px;border-radius:13px;background:#dcfce7;color:#166534;font-size:23px;font-weight:900}
    .final{background:#1d4ed8;color:#fff}
    .orb{position:absolute;right:-520px;top:-390px;width:1450px;height:1450px;border:220px solid #ffffff16;border-radius:50%}
    .final-lockup{position:absolute;left:84px;right:84px;top:650px}
    .final-brand{display:flex;align-items:center;gap:25px;font-size:104px;font-weight:900;letter-spacing:-.06em}
    .final-mark{width:132px;height:132px;display:grid;place-items:center;border-radius:32px;background:#fff;color:#1d4ed8}
    .final-line{font-size:48px;line-height:1.2;color:#dbeafe;margin:50px 0 0 155px}.final-line span{display:block}
  </style>
</head>
<body>
<div id="root" data-composition-id="main" data-start="0" data-duration="23" data-width="1080" data-height="1920">
  <section id="pain" class="clip scene" data-start="0" data-duration="4" data-track-index="0">
    <div class="brand"><span class="brand-mark">T</span>Tailor CV</div>
    <div class="title-zone">
      <div class="kicker">El problema real</div>
      <h1><span>Cada oferta pide</span> <span class="accent">un currículum distinto.</span></h1>
      <p class="lead">Y volver a adaptarlo consume tiempo.</p>
    </div>
    <div class="vacancies">
      <article class="job-card"><div class="job-meta">Oferta 01 · Producto</div><div class="job-title">Software Engineer</div><div class="job-tags"><span class="tag">React</span><span class="tag">APIs</span></div></article>
      <article class="job-card"><div class="job-meta">Oferta 02 · Datos</div><div class="job-title">Backend Developer</div><div class="job-tags"><span class="tag">Python</span><span class="tag">SQL</span></div></article>
      <article class="job-card"><div class="job-meta">Oferta 03 · Plataforma</div><div class="job-title">Full Stack Developer</div><div class="job-tags"><span class="tag">Node.js</span><span class="tag">Cloud</span></div></article>
      <div class="resume-card"><div class="resume-head"></div><div class="line"></div><div class="line medium"></div><div class="line"></div><div class="line short"></div><div class="line"></div><div class="line medium"></div><div class="line short"></div><div class="again">Adaptar otra vez</div></div>
    </div>
  </section>

  <section id="cost" class="clip scene" data-start="4" data-duration="3" data-track-index="0">
    <div class="brand"><span class="brand-mark">T</span>Tailor CV</div>
    <div class="title-zone">
      <div class="kicker">El costo</div>
      <h2><span>Más edición.</span> <span class="accent">Cero garantías.</span></h2>
      <p class="lead">Horas ajustando detalles sin saber si llegará una llamada.</p>
    </div>
    <div class="pain-grid">
      <article class="pain-card surface"><div class="clock"></div><div class="pain-label">Tiempo que se va</div><div class="pain-copy">Reescribir, ordenar y volver a exportar.</div></article>
      <article class="pain-card surface"><div class="no-call">?</div><div class="pain-label">Sin llamada segura</div><div class="pain-copy">Adaptar ayuda, pero nunca garantiza respuesta.</div></article>
    </div>
  </section>

  <section id="tailor" class="clip scene" data-start="7" data-duration="5.5" data-track-index="0">
    <div class="brand"><span class="brand-mark">T</span>Tailor CV</div>
    <div class="title-zone">
      <div class="kicker">Menos trabajo manual</div>
      <h2><span>Oferta dentro.</span> <span class="accent">Currículum enfocado.</span></h2>
      <p class="lead">Tailor CV usa la vacante como contexto para adaptar tu experiencia.</p>
    </div>
    <div class="app-shell">
      <div class="app-top"><span>✦ Generar currículum</span><small>Tailor CV</small></div>
      <div class="flow">
        <div class="panel">
          <div class="panel-title">1. Oferta laboral</div>
          <div class="input">Software Engineer</div>
          <div class="input textarea">Buscamos experiencia en React, APIs y colaboración con equipos de producto.</div>
          <div class="cta">✦ Analizar oferta</div>
        </div>
        <div class="arrow">→</div>
        <div class="panel">
          <div class="panel-title">2. Resultado editable</div>
          <div class="cv-mini">
            <h3>Alex Rivera</h3><div class="role">Software Engineer</div>
            <div class="line"></div><div class="line medium"></div>
            <h4>Experiencia relevante</h4><div class="line"></div><div class="line"></div><div class="line short"></div>
            <h4>Habilidades</h4><div class="line medium"></div><div class="line short"></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="analysis" class="clip scene" data-start="12.5" data-duration="3.5" data-track-index="0">
    <div class="brand"><span class="brand-mark">T</span>Tailor CV</div>
    <div class="title-zone">
      <div class="kicker">También analiza</div>
      <h2><span>Descubre cómo</span> <span class="accent">mejorar tu currículum.</span></h2>
    </div>
    <div class="analysis-shell surface">
      <div class="analysis-head"><h3>Resultados del análisis</h3><div class="score">55<small>/100</small></div></div>
      <p class="analysis-copy">Evaluación por diseño visual, estructura y calidad del contenido.</p>
      <div class="metrics"><div class="metric"><strong>55</strong><span>Diseño</span></div><div class="metric"><strong>60</strong><span>Estructura</span></div><div class="metric"><strong>50</strong><span>Contenido</span></div></div>
      <div class="suggestions"><div class="suggestion"><b>01</b> Mejora jerarquía y legibilidad.</div><div class="suggestion"><b>02</b> Refuerza palabras clave del puesto.</div><div class="suggestion"><b>03</b> Convierte tareas en logros concretos.</div></div>
    </div>
  </section>

  <section id="email" class="clip scene" data-start="16" data-duration="4.5" data-track-index="0">
    <div class="brand"><span class="brand-mark">T</span>Tailor CV</div>
    <div class="title-zone">
      <div class="kicker">Sin salir de la app</div>
      <h2><span>Revisa. Edita.</span> <span class="accent">Envía por correo.</span></h2>
      <p class="lead">Currículum y mensaje de postulación, listos en el mismo flujo.</p>
    </div>
    <div class="email-shell surface">
      <div class="email-title"><h3>Enviar por correo</h3><div class="mail-icon">✉</div></div>
      <div class="field-label">Para</div><div class="email-field">reclutamiento@empresa.com</div>
      <div class="field-label">Asunto</div><div class="email-field">Postulación · Software Engineer</div>
      <div class="field-label">Mensaje</div><div class="email-field email-body">Hola, comparto mi currículum adaptado a la posición de Software Engineer. Gracias por considerar mi perfil.</div>
      <div class="send-row"><div class="send-button">Enviar currículum</div><div class="sent">Enviado ✓</div></div>
    </div>
  </section>

  <section id="close" class="clip final" data-start="20.5" data-duration="2.5" data-track-index="0">
    <div class="orb" data-layout-ignore></div>
    <div class="final-lockup">
      <div class="final-brand"><span class="final-mark">T</span><span>Tailor CV</span></div>
      <div class="final-line"><span>Menos tiempo ajustando.</span><span>Más tiempo postulando.</span></div>
    </div>
  </section>

